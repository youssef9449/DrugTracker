# Google AI Studio writes transient files into this directory while
# the preview is running (logs, scratch JSON, etc.). They all start
# with a leading dot, so we ignore them but keep the bundled assets
# (icons, screenshots, sounds) and the .gitkeep / .gitignore files
# themselves under version control.

# Ignore all dotfiles (AI Studio's transient files).
.*
# Re-allow the dotfiles we explicitly want to track.
!.gitignore
!.gitkeep
